  "LCA (binary lifting)": {
    "prefix": "lca",
    "description": "Binary lifting LCA",
    "body": [
      "const int LOG = 20;",
      "vector<array<int, LOG>> up;",
      "vector<int> depth;",
      "void dfs_lca(int u, int p, const vector<vector<int>> &adj) {",
      "    up[u][0] = p;",
      "    for (int k = 1; k < LOG; k++) up[u][k] = up[up[u][k - 1]][k - 1];",
      "    for (int v : adj[u]) if (v != p) { depth[v] = depth[u] + 1; dfs_lca(v, u, adj); }",
      "}",
      "int lca(int a, int b) {",
      "    if (depth[a] < depth[b]) swap(a, b);",
      "    for (int k = LOG - 1; k >= 0; k--) if (depth[a] - (1 << k) >= depth[b]) a = up[a][k];",
      "    if (a == b) return a;",
      "    for (int k = LOG - 1; k >= 0; k--) if (up[a][k] != up[b][k]) a = up[a][k], b = up[b][k];",
      "    return up[a][0];",
      "}"
    ]
  },
  "Sparse table": {
    "prefix": "sparse",
    "description": "O(1) range min",
    "body": [
      "struct Sparse {",
      "    vector<vector<int>> t;",
      "    Sparse(const vector<int> &a) {",
      "        int n = a.size(), K = __lg(max(n, 1)) + 1;",
      "        t.assign(K, a);",
      "        for (int k = 1; k < K; k++)",
      "            for (int i = 0; i + (1 << k) <= n; i++) t[k][i] = min(t[k - 1][i], t[k - 1][i + (1 << (k - 1))]);",
      "    }",
      "    int query(int l, int r) { int k = __lg(r - l + 1); return min(t[k][l], t[k][r - (1 << k) + 1]); } // [l, r]",
      "};"
    ]
  },
  "Custom hash": {
    "prefix": "chash",
    "description": "Anti-hack hash for unordered_map",
    "body": [
      "struct custom_hash {",
      "    static uint64_t splitmix64(uint64_t x) {",
      "        x += 0x9e3779b97f4a7c15;",
      "        x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;",
      "        x = (x ^ (x >> 27)) * 0x94d049bb133111eb;",
      "        return x ^ (x >> 31);",
      "    }",
      "    size_t operator()(uint64_t x) const {",
      "        static const uint64_t R = chrono::steady_clock::now().time_since_epoch().count();",
      "        return splitmix64(x + R);",
      "    }",
      "};",
      "// unordered_map<ll, int, custom_hash> mp;"
    ]
  },
