  "DSU": {
    "prefix": "dsu",
    "description": "Disjoint set union (path compression + union by size)",
    "body": [
      "struct DSU {",
      "    vector<int> p, sz;",
      "    DSU(int n) : p(n), sz(n, 1) { iota(p.begin(), p.end(), 0); }",
      "    int find(int x) { while (x != p[x]) x = p[x] = p[p[x]]; return x; }",
      "    bool unite(int a, int b) {",
      "        a = find(a), b = find(b);",
      "        if (a == b) return false;",
      "        if (sz[a] < sz[b]) swap(a, b);",
      "        p[b] = a;",
      "        sz[a] += sz[b];",
      "        return true;",
      "    }",
      "    int size(int x) { return sz[find(x)]; }",
      "};"
    ]
  },
  "Fenwick tree": {
    "prefix": "fenwick",
    "description": "BIT: point add, prefix sum",
    "body": [
      "struct Fenwick {",
      "    int n;",
      "    vector<ll> t;",
      "    Fenwick(int n) : n(n), t(n + 1, 0) {}",
      "    void add(int i, ll v) { for (i++; i <= n; i += i & -i) t[i] += v; }",
      "    ll sum(int i) { ll s = 0; for (i++; i > 0; i -= i & -i) s += t[i]; return s; } // [0, i]",
      "    ll sum(int l, int r) { return sum(r) - (l ? sum(l - 1) : 0); }",
      "};"
    ]
  },
  "Segment tree": {
    "prefix": "segtree",
    "description": "Iterative segment tree (point set, range query)",
    "body": [
      "template <class T, class F>",
      "struct SegTree {",
      "    int n;",
      "    T id;",
      "    F op;",
      "    vector<T> t;",
      "    SegTree(int n, T id, F op) : n(n), id(id), op(op), t(2 * n, id) {}",
      "    void set(int i, T v) {",
      "        for (t[i += n] = v; i > 1; i >>= 1) t[i >> 1] = op(t[i & ~1], t[i | 1]);",
      "    }",
      "    T query(int l, int r) { // [l, r)",
      "        T resl = id, resr = id;",
      "        for (l += n, r += n; l < r; l >>= 1, r >>= 1) {",
      "            if (l & 1) resl = op(resl, t[l++]);",
      "            if (r & 1) resr = op(t[--r], resr);",
      "        }",
      "        return op(resl, resr);",
      "    }",
      "};",
      "// SegTree st(n, 0LL, [](ll a, ll b) { return a + b; });"
    ]
  },
  "Lazy segment tree": {
    "prefix": "lazyseg",
    "description": "Range add, range sum",
    "body": [
      "struct LazySeg {",
      "    int n;",
      "    vector<ll> sum, lz;",
      "    LazySeg(int n) : n(n), sum(4 * n), lz(4 * n) {}",
      "    void apply(int x, int len, ll v) { sum[x] += v * len; lz[x] += v; }",
      "    void push(int x, int l, int r) {",
      "        if (!lz[x]) return;",
      "        int m = (l + r) / 2;",
      "        apply(2 * x, m - l, lz[x]);",
      "        apply(2 * x + 1, r - m, lz[x]);",
      "        lz[x] = 0;",
      "    }",
      "    void add(int ql, int qr, ll v, int x = 1, int l = 0, int r = -1) { // [ql, qr)",
      "        if (r < 0) r = n;",
      "        if (qr <= l || r <= ql) return;",
      "        if (ql <= l && r <= qr) { apply(x, r - l, v); return; }",
      "        push(x, l, r);",
      "        int m = (l + r) / 2;",
      "        add(ql, qr, v, 2 * x, l, m);",
      "        add(ql, qr, v, 2 * x + 1, m, r);",
      "        sum[x] = sum[2 * x] + sum[2 * x + 1];",
      "    }",
      "    ll query(int ql, int qr, int x = 1, int l = 0, int r = -1) {",
      "        if (r < 0) r = n;",
      "        if (qr <= l || r <= ql) return 0;",
      "        if (ql <= l && r <= qr) return sum[x];",
      "        push(x, l, r);",
      "        int m = (l + r) / 2;",
      "        return query(ql, qr, 2 * x, l, m) + query(ql, qr, 2 * x + 1, m, r);",
      "    }",
      "};"
    ]
  },
  "Modint": {
    "prefix": "modint",
    "description": "Modular integer",
    "body": [
      "template <int MOD>",
      "struct Mint {",
      "    int v;",
      "    Mint(ll x = 0) { v = int(x % MOD); if (v < 0) v += MOD; }",
      "    Mint &operator+=(Mint o) { if ((v += o.v) >= MOD) v -= MOD; return *this; }",
      "    Mint &operator-=(Mint o) { if ((v -= o.v) < 0) v += MOD; return *this; }",
      "    Mint &operator*=(Mint o) { v = int(1LL * v * o.v % MOD); return *this; }",
      "    Mint pow(ll e) const { Mint r = 1, b = *this; for (; e; e >>= 1, b *= b) if (e & 1) r *= b; return r; }",
      "    Mint inv() const { return pow(MOD - 2); }",
      "    Mint &operator/=(Mint o) { return *this *= o.inv(); }",
      "    friend Mint operator+(Mint a, Mint b) { return a += b; }",
      "    friend Mint operator-(Mint a, Mint b) { return a -= b; }",
      "    friend Mint operator*(Mint a, Mint b) { return a *= b; }",
      "    friend Mint operator/(Mint a, Mint b) { return a /= b; }",
      "    friend ostream &operator<<(ostream &os, Mint a) { return os << a.v; }",
      "};",
      "using mint = Mint<${1:998244353}>;"
    ]
  },
  "nCr": {
    "prefix": "ncr",
    "description": "Factorials and binomial mod p",
    "body": [
      "const int MOD = ${1:1000000007}, MAXN = ${2:200005};",
      "ll fact[MAXN], inv_fact[MAXN];",
      "ll power(ll b, ll e) { ll r = 1; b %= MOD; for (; e; e >>= 1, b = b * b % MOD) if (e & 1) r = r * b % MOD; return r; }",
      "void init_fact() {",
      "    fact[0] = 1;",
      "    for (int i = 1; i < MAXN; i++) fact[i] = fact[i - 1] * i % MOD;",
      "    inv_fact[MAXN - 1] = power(fact[MAXN - 1], MOD - 2);",
      "    for (int i = MAXN - 1; i > 0; i--) inv_fact[i - 1] = inv_fact[i] * i % MOD;",
      "}",
      "ll C(int n, int k) { return k < 0 || k > n ? 0 : fact[n] * inv_fact[k] % MOD * inv_fact[n - k] % MOD; }"
    ]
  },
  "Binary power": {
    "prefix": "binpow",
    "description": "a^e mod m",
    "body": [
      "ll power(ll b, ll e, ll m) {",
      "    ll r = 1;",
      "    b %= m;",
      "    for (; e; e >>= 1, b = b * b % m)",
      "        if (e & 1) r = r * b % m;",
      "    return r;",
      "}"
    ]
  },
  "Sieve (SPF)": {
    "prefix": "sieve",
    "description": "Smallest prime factor sieve",
    "body": [
      "const int MAXV = ${1:1000001};",
      "int spf[MAXV];",
      "void sieve() {",
      "    for (int i = 2; i < MAXV; i++)",
      "        if (!spf[i])",
      "            for (int j = i; j < MAXV; j += i)",
      "                if (!spf[j]) spf[j] = i;",
      "}"
    ]
